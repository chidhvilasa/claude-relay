{
  "name": "claude-relay",
  "displayName": "Claude Relay",
  "description": "Session continuity, recovery, checkpoints, and handoffs for Claude Code.",
  "version": "0.3.0-dev",
  "publisher": "clauderelay-oss",
  "repository": {
    "type": "git",
    "url": "https://github.com/chidhvilasa/claude-relay.git"
  },
  "bugs": {
    "url": "https://github.com/chidhvilasa/claude-relay/issues"
  },
  "homepage": "https://github.com/chidhvilasa/claude-relay#readme",
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "claude",
    "claude code",
    "claude relay",
    "ai",
    "coding assistant",
    "developer tools",
    "session continuity",
    "context recovery",
    "recovery",
    "checkpoint",
    "checkpoints",
    "handoff",
    "handoffs",
    "session recovery",
    "context",
    "agent",
    "git"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeRelay.setup",
        "title": "Claude Relay: Set Up"
      },
      {
        "command": "claudeRelay.healthCheck",
        "title": "Claude Relay: Health Check"
      },
      {
        "command": "claudeRelay.checkpoint",
        "title": "Claude Relay: Create Checkpoint"
      },
      {
        "command": "claudeRelay.handoff",
        "title": "Claude Relay: Create Handoff Now"
      },
      {
        "command": "claudeRelay.resume",
        "title": "Claude Relay: Resume Previous Task"
      },
      {
        "command": "claudeRelay.openLatestHandoff",
        "title": "Claude Relay: Open Latest Handoff"
      },
      {
        "command": "claudeRelay.openDashboard",
        "title": "Claude Relay: Open Dashboard"
      },
      {
        "command": "claudeRelay.clearResolvedHandoff",
        "title": "Claude Relay: Clear Resolved Handoff"
      },
      {
        "command": "claudeRelay.reinstallClaudeIntegration",
        "title": "Claude Relay: Reinstall Claude Integration"
      },
      {
        "command": "claudeRelay.removeClaudeIntegration",
        "title": "Claude Relay: Remove Claude Integration"
      },
      {
        "command": "claudeRelay.showLogs",
        "title": "Claude Relay: Show Logs"
      },
      {
        "command": "claudeRelay.enableAutomaticWake",
        "title": "Claude Relay: Enable Automatic Wake"
      },
      {
        "command": "claudeRelay.disableAutomaticWake",
        "title": "Claude Relay: Disable Automatic Wake"
      },
      {
        "command": "claudeRelay.showWakeDiagnostics",
        "title": "Claude Relay: Show Wake Diagnostics"
      },
      {
        "command": "claudeRelay.cancelPendingWake",
        "title": "Claude Relay: Cancel Pending Wake"
      },
      {
        "command": "claudeRelay.resumePendingSession",
        "title": "Claude Relay: Resume Pending Session"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeRelay",
          "title": "Claude Relay",
          "icon": "media/relay-activity.svg"
        }
      ]
    },
    "views": {
      "claudeRelay": [
        {
          "id": "claudeRelayDashboard",
          "name": "Dashboard"
        }
      ]
    },
    "configuration": {
      "title": "Claude Relay",
      "properties": {
        "claudeRelay.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Claude Relay"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "claudeRelayGettingStarted",
        "title": "Get Started with Claude Relay",
        "description": "Set up automatic protection, then try a real checkpoint and handoff.",
        "icon": "media/icon.png",
        "steps": [
          {
            "id": "installPlugin",
            "title": "Install the Claude Relay Plugin",
            "description": "",
            "media": { "markdown": "media/walkthrough/01-install-plugin.md" }
          },
          {
            "id": "verifyProtection",
            "title": "Verify Protection",
            "description": "",
            "media": { "markdown": "media/walkthrough/02-verify-protection.md" },
            "completionEvents": ["onCommand:claudeRelay.healthCheck"]
          },
          {
            "id": "firstCheckpoint",
            "title": "Create Your First Checkpoint",
            "description": "",
            "media": { "markdown": "media/walkthrough/03-first-checkpoint.md" },
            "completionEvents": ["onCommand:claudeRelay.checkpoint"]
          },
          {
            "id": "understandRecovery",
            "title": "Understand Recovery",
            "description": "",
            "media": { "markdown": "media/walkthrough/04-understand-recovery.md" },
            "completionEvents": ["onCommand:claudeRelay.handoff"]
          },
          {
            "id": "openDashboard",
            "title": "Open the Relay Dashboard",
            "description": "",
            "media": { "markdown": "media/walkthrough/05-open-dashboard.md" },
            "completionEvents": ["onCommand:claudeRelay.openDashboard"]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "prebuild": "pnpm --filter @claude-relay/core run build && pnpm --filter @claude-relay/wake-runtime run build",
    "build": "esbuild src/extension.ts --bundle --external:vscode --format=cjs --platform=node --outfile=dist/extension.js",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run build",
    "test": "pnpm run test:unit && tsc -p ./ && node dist/test/runTest.js",
    "test:unit": "vitest run tests",
    "test:host": "tsc -p ./ && node dist/test/runTest.js",
    "lint": "eslint src --ext ts",
    "pretypecheck": "pnpm --filter @claude-relay/core run build && pnpm --filter @claude-relay/wake-runtime run build",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "package": "npx vsce package --no-dependencies"
  },
  "dependencies": {
    "@claude-relay/core": "workspace:*",
    "@claude-relay/wake-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "1.74.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "glob": "^11.0.1",
    "mocha": "^11.1.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}